# Root environment example for local development.
# Copy to .env locally if needed. Do not commit real secrets.

SPRING_PROFILES_ACTIVE=local
BACKEND_PORT=8080
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
AI_PORT=8000
SIGAK_DB_URL=jdbc:postgresql://localhost:5432/sigak
SIGAK_DB_USERNAME=sigak
SIGAK_DB_PASSWORD=sigak
SIGAK_AI_SERVER_URL=http://localhost:8000
SIGAK_RESEARCH_ARTIFACT_ROOT=experiments
SIGAK_COLLECTION_HTTP_CONNECT_TIMEOUT=5s
SIGAK_COLLECTION_HTTP_READ_TIMEOUT=30s
SIGAK_COLLECTION_ARXIV_MIN_REQUEST_INTERVAL=3s
SIGAK_COLLECTION_ARXIV_RATE_LIMIT_RETRY_DELAY=30s
SIGAK_COLLECTION_ARXIV_TRANSIENT_FETCH_RETRY_DELAY=5s
SIGAK_COLLECTION_ARXIV_MAX_TRANSIENT_FETCH_RETRIES=1
SIGAK_COLLECTION_ARXIV_MAX_RATE_LIMIT_RETRIES=2
SIGAK_COLLECTION_ARXIV_COOLDOWN_STATE_FILE=/tmp/sigak/arxiv-export-fetch.cooldown
SIGAK_EMBEDDING_PROVIDER=local
SIGAK_EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# 운영 문서 retrieval 실험에서 AI 서버의 모델과 일치시킨다.
SIGAK_RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# 후속 Checkpoint B용이다. 현재 생성·judge 실행은 미구현이며 비워 둔다.
SIGAK_RAG_RERANKER_MODEL=
SIGAK_RAG_GENERATOR_MODEL=
SIGAK_RAG_JUDGE_MODEL=
OPENAI_API_KEY=
SIGAK_RAG_INPUT_PRICE_PER_MILLION_USD=
SIGAK_RAG_OUTPUT_PRICE_PER_MILLION_USD=
SIGAK_ELASTICSEARCH_URL=http://localhost:9200
SIGAK_ELASTICSEARCH_ARTICLE_INDEX=sigak-articles-v1
SIGAK_QDRANT_URL=http://localhost:6333
SIGAK_NEO4J_URI=bolt://localhost:7687
SIGAK_NEO4J_USERNAME=neo4j
SIGAK_NEO4J_PASSWORD=sigak-neo4j-password
