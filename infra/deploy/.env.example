# 기본값은 이 컴퓨터에서만 접속한다. 공개 서버 설정은 README를 따른다.
SIGAK_BIND_ADDRESS=127.0.0.1
SIGAK_HTTP_PORT=8088
SIGAK_HTTPS_PORT=8443
SIGAK_SITE_ADDRESS=:80
# 각각 서로 다른 임의의 긴 값을 넣는다. 빈 값이면 시작을 거부한다.
SIGAK_DB_PASSWORD=
SIGAK_NEO4J_PASSWORD=
SIGAK_EMBEDDING_PROVIDER=local
SIGAK_EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# 배포에서는 각 실행이 끝난 뒤 10분 대기하며 기술 뉴스 수집을 반복한다.
SIGAK_COLLECTION_AUTOMATION_ENABLED=true
SIGAK_COLLECTION_AUTOMATION_FIXED_DELAY=PT10M
SIGAK_COLLECTION_AUTOMATION_INITIAL_DELAY=PT30S
SIGAK_COLLECTION_AUTOMATION_MAX_ARTICLES_PER_SOURCE=20
SIGAK_COLLECTION_AUTOMATION_SOURCE_IDS=
